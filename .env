# ===========================================================================
# 电视端 AI 慢任务 Planner 本地配置（已加入 .gitignore）
# ===========================================================================
# 从 .env.example 复制而来，按需修改。
# 环境变量优先级高于此文件（便于 CI/CD 或临时覆盖）。
# ===========================================================================

# ---- vLLM 模型服务 ----
VLLM_BASE_URL=http://localhost:9000/v1
VLLM_MODEL=baseline
VLLM_API_KEY=EMPTY
VLLM_TIMEOUT=60
VLLM_REQUEST_FORMAT=structured_outputs

# ---- 检索层 (/retrieve) ----
RETRIEVE_ENABLED=0
RETRIEVE_BASE_URL=http://10.18.231.63:31935
RETRIEVE_TOOL_K=3
RETRIEVE_PARAMETER_K=6
RETRIEVE_VALUE_K=6
RETRIEVE_TIMEOUT=5

# ---- Planner 行为 ----
PLANNER_STUB=0
PLANNER_VOD_ONLY=0
PLANNER_EDUC_ONLY=0
PLANNER_MAX_REPAIRS=2

# ---- Experience Bank ----
EB_ENABLED=1
EB_PROMPT_ENABLED=1
EB_COMPILER_ENABLED=1
EB_ACTION_OVERRIDE=1
EB_FIELD_REMAP=1
EB_VALUE_NORMALIZE=1
EB_SORT_CONTROL=1
EB_QUERY_TEXT_COMPLETE=1
EB_TITLE_PROCESS=1
EB_TIME_CONVERT=1
EB_NAME_NORMALIZE=1
EB_STRUCTURE_SIMPLIFY=1

# ---- 评测 (bench) ----
BENCH_WORKERS=16
BENCH_OUTPUT=
BENCH_TRACE=

# ---- 服务端 (server.py) ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8082
